<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.HamrahangMobile" parent="Theme.Material3.Dark.NoActionBar" />

    <!-- Selected tab is icon color only; no pill behind the icon. -->
    <style name="Widget.Hamrahang.BottomNavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@android:color/transparent</item>
    </style>

    <style name="Widget.Hamrahang.LandNavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
    </style>
</resources>

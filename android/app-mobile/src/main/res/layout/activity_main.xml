<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/fragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:id="@+id/miniPlayer"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorSurfaceContainerHigh"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="4dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/miniArtwork"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/miniTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceBodyMedium" />

            <ImageButton
                android:id="@+id/miniPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/play_pause"
                android:src="@drawable/ic_play" />
        </LinearLayout>
    </LinearLayout>

    <!-- Portrait: max 5 items (Material limit). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layoutDirection="ltr"
        app:itemActiveIndicatorStyle="@style/Widget.Hamrahang.BottomNavIndicator"
        app:itemBackground="@android:color/transparent"
        app:itemIconSize="32dp"
        app:itemIconTint="@color/bottom_nav_icon_tint"
        app:itemPaddingBottom="8dp"
        app:itemPaddingTop="8dp"
        app:itemRippleColor="@android:color/transparent"
        app:labelVisibilityMode="unlabeled"
        app:menu="@menu/bottom_nav" />

    <!-- Landscape: custom bar so we can show 7 icons without crashing. -->
    <LinearLayout
        android:id="@+id/landscapeBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/landDevice"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_device"
            android:src="@drawable/ic_nav_folder" />

        <ImageButton
            android:id="@+id/landSlot1"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_home"
            android:src="@drawable/ic_nav_home" />

        <ImageButton
            android:id="@+id/landSlot2"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_live"
            android:src="@drawable/ic_nav_live" />

        <ImageButton
            android:id="@+id/landSlot3"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_search"
            android:src="@drawable/ic_nav_search" />

        <ImageButton
            android:id="@+id/landSlot4"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_library"
            android:src="@drawable/ic_nav_library" />

        <ImageButton
            android:id="@+id/landSlot5"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_settings"
            android:src="@drawable/ic_nav_settings" />

        <ImageButton
            android:id="@+id/landMenu"
            style="@style/LandNavButton"
            android:contentDescription="@string/nav_player"
            android:src="@drawable/ic_nav_menu" />
    </LinearLayout>
</LinearLayout>

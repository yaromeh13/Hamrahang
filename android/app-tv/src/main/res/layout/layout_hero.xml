<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/heroRoot"
    android:layout_width="match_parent"
    android:layout_height="260dp"
    android:layoutDirection="locale">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layoutDirection="locale">

        <ir.hamrahang.tv.ui.widget.FadeImageView
            android:id="@+id/heroArt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            app:layout_constraintWidth_percent="0.7"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <include
        android:id="@+id/musicVideoHero"
        layout="@layout/hero_musicvideo"
        android:visibility="gone"/>

    <include
        android:id="@+id/itemHero"
        layout="@layout/hero_item"
        android:visibility="gone"/>

    <include
        android:id="@+id/artistHero"
        layout="@layout/hero_artist"
        android:visibility="gone"/>

</FrameLayout>
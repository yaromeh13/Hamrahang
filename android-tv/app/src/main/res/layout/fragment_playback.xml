<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- LEFT PANEL -->

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/leftPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="@dimen/_10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/rightPanel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="0.5">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"

            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/playerContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Cover -->

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/imgCover"
                android:layout_width="@dimen/_110sdp"
                android:layout_height="@dimen/_110sdp"
                android:scaleType="centerCrop"
                android:src="@drawable/card_bg"

                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <!-- Song Title -->

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_16dp"
                android:text="Song Name"

                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:textSize="24sp"

                app:layout_constraintStart_toEndOf="@id/imgCover"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/imgCover"/>

            <!-- Album -->

            <TextView
                android:id="@+id/txtAlbum"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#DDFFFFFF"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="@id/txtTitle"
                app:layout_constraintTop_toBottomOf="@id/txtTitle"/>

            <!-- Artists -->

            <LinearLayout
                android:id="@+id/layoutArtists"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical"

                app:layout_constraintStart_toStartOf="@id/txtTitle"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtAlbum"/>

            <!-- Meta Row -->

            <LinearLayout
                android:id="@+id/layoutMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/imgCover"/>

            <!-- Tags -->

            <LinearLayout
                android:id="@+id/layoutTags"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"

                app:layout_constraintTop_toBottomOf="@id/layoutMeta"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        </androidx.constraintlayout.widget.ConstraintLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/playerContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"

            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">
        <!-- CONTROLS -->

        <LinearLayout
            android:id="@+id/playerControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_24dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:textDirection="ltr"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/btnBookmark"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_bookmark"
                android:background="@drawable/bg_player_round"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_skip_previous"
                android:background="@drawable/bg_player_round"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:layout_marginHorizontal="18dp"
                android:src="@drawable/ic_play_arrow"
                android:background="@drawable/bg_player_round"
                android:focusable="true"
                android:clickable="true"
                android:focusableInTouchMode="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_skip_next"
                android:background="@drawable/bg_player_round"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnFav"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/ic_favorite"
                android:background="@drawable/bg_player_round"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

        </LinearLayout>

        <!-- SEEK -->

        <SeekBar
            android:id="@+id/seekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_18dp"
            android:layoutDirection="ltr"
            android:textDirection="ltr"
            android:minHeight="4dp"
            android:maxHeight="4dp"

            android:progressDrawable="@drawable/seekbar_progress"
            android:thumb="@drawable/seekbar_thumb"
            android:splitTrack="false"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            app:layout_constraintTop_toBottomOf="@id/playerControls"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/txtTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="00:00 / 00:00"
            android:textColor="#CFFFFFFF"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/seekBar"
            app:layout_constraintStart_toStartOf="@id/seekBar"/>

        <LinearLayout
            android:id="@+id/playerActions"
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_26dp"
            android:orientation="horizontal"
            android:layoutDirection="ltr"
            android:textDirection="ltr"
            app:layout_constraintTop_toBottomOf="@id/txtTime"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnShuffle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_shuffle"
                android:background="@drawable/bg_player_square"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnRepeat"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:src="@drawable/ic_repeat"
                android:background="@drawable/bg_player_square"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnMute"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:src="@drawable/ic_volume_up"
                android:background="@drawable/bg_player_square"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnLyrics"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:src="@drawable/ic_lyrics"
                android:background="@drawable/bg_player_square"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnPlaylist"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:src="@drawable/ic_queue_music"
                android:background="@drawable/bg_player_square"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="18dp"
                android:src="@drawable/ic_fullscreen"
                android:background="@drawable/bg_player_square"
                android:focusable="true"
                android:clickable="true"
                android:tint="@android:color/white"/>

        </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RIGHT PANEL -->

    <FrameLayout
        android:id="@+id/rightPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="@dimen/_10dp"
        android:background="@drawable/bg_playlist_panel"
        android:clipToOutline="true"
        android:padding="@dimen/_10dp"
        app:layout_constraintStart_toEndOf="@id/leftPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <include
              layout="@layout/layout_queue_recycler"/>

        <FrameLayout
            android:id="@+id/lyricsContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNoLyrics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="No Lyrics"
                android:textColor="#FFFFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"/>

        </FrameLayout>

    </FrameLayout>
    <include
        android:id="@+id/messageContainer"
        layout="@layout/widget_message"/>
</androidx.constraintlayout.widget.ConstraintLayout>
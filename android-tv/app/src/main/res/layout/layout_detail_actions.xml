<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDetailPlay"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:minHeight="40dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="100dp"
        android:paddingStart="0dp"
        android:paddingEnd="14dp"
        android:background="@drawable/bg_detail_play"
        android:backgroundTint="@null"
        android:gravity="center"
        android:textAlignment="center"
        android:includeFontPadding="false"
        app:backgroundTint="@null"
        app:icon="@drawable/ic_detail_play_arrow"
        app:iconTint="@android:color/white"
        app:iconSize="20dp"
        app:iconPadding="0dp"
        app:iconGravity="textStart"
        android:layout_marginEnd="10dp"
        android:textSize="28sp"
        android:text="@string/play"
        android:textColor="@android:color/white"
        android:textAllCaps="false"
        android:contentDescription="@string/play"
        android:focusable="true" />

    <ImageButton
        android:id="@+id/btnDetailBookmark"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_detail_action"
        android:src="@drawable/ic_bookmark"
        android:tint="@android:color/white"
        android:contentDescription="Bookmark"
        android:focusable="true" />

    <ImageButton
        android:id="@+id/btnDetailMore"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_detail_action"
        android:src="@drawable/ic_more"
        android:tint="@android:color/white"
        android:contentDescription="More"
        android:focusable="true" />

    <ImageButton
        android:id="@+id/btnDetailInfo"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_detail_action"
        android:src="@drawable/ic_info"
        android:tint="@android:color/white"
        android:contentDescription="Info"
        android:focusable="true" />
</LinearLayout>

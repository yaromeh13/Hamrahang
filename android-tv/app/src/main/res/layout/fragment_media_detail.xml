<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <include
        android:id="@+id/heroContainer"
        layout="@layout/layout_hero"
        android:layout_width="match_parent"
        android:layout_height="260dp" />

    <include
        android:id="@+id/singleItemActions"
        layout="@layout/layout_detail_actions"
        android:layout_width="match_parent"
        android:layout_marginStart="16dp"
        android:layout_height="wrap_content" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.leanback.widget.VerticalGridView
            android:id="@+id/detailRows"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/content_edge_spacing"
            android:layout_marginTop="14dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:paddingTop="0dp"
            android:paddingBottom="0dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <TextView
            android:id="@+id/detailLyrics"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:gravity="top|start"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>

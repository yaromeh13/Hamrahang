<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/liveSearchHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layoutDirection="ltr"
        android:paddingTop="24dp"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/liveSearchInput"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:background="@drawable/bg_search_input"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:hint="@string/live_search_hint"
            android:textSize="18sp"
            android:singleLine="true"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:nextFocusRight="@id/liveSearchClear"
            android:nextFocusLeft="@id/liveSearchClear"
            android:nextFocusDown="@id/liveRowsRecycler"
            android:paddingStart="20dp"
            android:paddingEnd="20dp" />

        <TextView
            android:id="@+id/liveSearchClear"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_detail_play"
            android:gravity="center"
            android:text="×"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:contentDescription="@string/live_search_clear"
            android:focusable="true"
            android:clickable="true"
            android:visibility="gone"
            android:nextFocusRight="@id/liveSearchSubmit"
            android:nextFocusLeft="@id/liveSearchInput"
            android:nextFocusDown="@id/liveRowsRecycler" />

        <TextView
            android:id="@+id/liveSearchSubmit"
            android:layout_width="112dp"
            android:layout_height="56dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_detail_play"
            android:gravity="center"
            android:text="@string/live_search_submit"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:focusable="true"
            android:clickable="true"
            android:nextFocusLeft="@id/liveSearchClear"
            android:nextFocusRight="@id/liveSearchInput"
            android:nextFocusDown="@id/liveRowsRecycler" />

    </LinearLayout>
    <androidx.leanback.widget.VerticalGridView
        android:id="@+id/liveRowsRecycler"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:nextFocusUp="@id/liveSearchSubmit"
        android:paddingBottom="@dimen/_24dp"
        app:numberOfColumns="1"
        app:layout_constraintTop_toBottomOf="@id/liveSearchHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

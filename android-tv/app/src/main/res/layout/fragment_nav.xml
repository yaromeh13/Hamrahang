<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- SIDE MENU -->
    <LinearLayout
        android:id="@+id/sideMenu"
        android:layout_width="wrap_content"
        android:minWidth="@dimen/_100dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:paddingTop="@dimen/_8dp"
        android:paddingBottom="@dimen/_8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintWidth_percent="1"
        app:layout_constraintHeight="1">

        <!-- LOGO -->
        <LinearLayout
            android:id="@+id/logoContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_16dp"
            android:paddingEnd="@dimen/_16dp"
            android:focusable="false"
            android:clickable="false">

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_home"
                android:focusable="false"/>

            <TextView
                android:id="@+id/appTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_title"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="@dimen/_20sp"
                android:paddingStart="@dimen/_12dp"
                android:ellipsize="end"
                android:maxLines="1"/>
        </LinearLayout>

        <!-- HOME -->
        <LinearLayout
            android:id="@+id/menuHome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorHome"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914" />

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_home"/>

            <TextView
                android:id="@+id/textHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_home"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"/>
        </LinearLayout>

        <!-- LIVE -->
        <LinearLayout
            android:id="@+id/menuLive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorLive"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914"/>

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_live"/>

            <TextView
                android:id="@+id/textLive"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_live"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"/>
        </LinearLayout>

        <!-- SEARCH -->
        <LinearLayout
            android:id="@+id/menuSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorSearch"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914"/>

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_search"/>

            <TextView
                android:id="@+id/textSearch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_search"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"/>
        </LinearLayout>

        <!-- KIDS -->
        <LinearLayout
            android:id="@+id/menuKids"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorKids"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914"/>

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_kids"/>

            <TextView
                android:id="@+id/textKids"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_kids"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"/>
        </LinearLayout>

        <!-- CATEGORIES -->
        <LinearLayout
            android:id="@+id/menuCategories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorCategories"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914"/>

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_category"/>

            <TextView
                android:id="@+id/textCategories"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_categories"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"/>
        </LinearLayout>

        <!-- SETTINGS -->
        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorSetting"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914"/>

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_setting"/>

            <TextView
                android:id="@+id/textSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_setting"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"/>
        </LinearLayout>

        <!-- PROFILE -->
        <LinearLayout
            android:id="@+id/menuProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:tag="menuItem"
            android:background="@drawable/menu_focus"
            android:paddingTop="@dimen/_10dp"
            android:paddingBottom="@dimen/_10dp"
            android:paddingEnd="@dimen/_16dp">

            <View
                android:id="@+id/indicatorProfile"
                android:layout_width="@dimen/_5dp"
                android:layout_height="@dimen/_18dp"
                android:layout_marginEnd="@dimen/_12dp"
                android:background="#E50914"/>

            <ImageView
                android:layout_width="@dimen/_20dp"
                android:layout_height="@dimen/_20dp"
                android:src="@drawable/ic_profile"/>

            <TextView
                android:id="@+id/textProfile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/menu_profile"
                android:textColor="#FFFFFF"
                android:paddingStart="@dimen/_8sdp"
                android:textSize="@dimen/_8ssp"
                style="@style/Text.Menu"
                android:nextFocusDown="@id/btnMiniPlayPause"
                />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <!-- MINI PLAYER -->
        <LinearLayout
            android:id="@+id/playerMiniContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_70dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/_8dp"
            android:paddingEnd="@dimen/_8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnMiniCover"
                android:layout_width="@dimen/_42dp"
                android:layout_height="@dimen/_42dp"

                android:background="@drawable/bg_player_round"
                android:scaleType="centerCrop"
                android:padding="@dimen/_3dp"

                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:nextFocusUp="@id/menuProfile"
                android:src="@drawable/default_album"/>

            <ImageButton
                android:id="@+id/btnMiniPlayPause"
                android:layout_width="@dimen/_42dp"
                android:layout_height="@dimen/_42dp"
                android:layout_marginStart="@dimen/_2dp"
                android:background="@drawable/bg_player_round"
                android:src="@drawable/ic_pause"
                android:tint="@android:color/white"
                android:nextFocusUp="@id/menuProfile"
                android:padding="@dimen/_10dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"/>

            <ImageButton
                android:id="@+id/btnMiniFullscreen"
                android:layout_width="@dimen/_42dp"
                android:layout_height="@dimen/_42dp"
                android:layout_marginStart="@dimen/_2dp"
                android:background="@drawable/bg_player_round"
                android:padding="@dimen/_6dp"
                android:scaleType="centerInside"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:clickable="true"
                android:src="@drawable/ic_fullscreen"/>

        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
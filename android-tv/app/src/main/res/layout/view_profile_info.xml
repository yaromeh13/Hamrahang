<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Authenticated account: details on the left, avatar on the right. -->
    <LinearLayout
        android:id="@+id/layoutLogged"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="36dp"
        android:paddingEnd="36dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical|center_horizontal"
            android:orientation="vertical"
            android:paddingEnd="32dp">

            <TextView
                android:id="@+id/accountName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/accountUsername"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:textColor="#DDDDDD"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/accountEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#BBBBBB"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/accountId"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="#999999"
                android:textSize="15sp" />

            <Button
                android:id="@+id/logoutButton"
                android:layout_width="260dp"
                android:layout_height="58dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/bg_setting_option"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:text="@string/auth_logout"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="18sp" />
        </LinearLayout>

        <ImageView
            android:id="@+id/userAvatar"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:contentDescription="@string/auth_user_avatar"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <!-- Login form and QR code. The QR instructions occupy a separate bottom strip. -->
    <FrameLayout
        android:id="@+id/layoutLogin"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/loginMainRow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            android:paddingTop="8dp"
            android:paddingBottom="104dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingEnd="40dp">

                <EditText
                    android:id="@+id/emailInput"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="@string/auth_username_email"
                    android:paddingHorizontal="20dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999" />

                <EditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="58dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_search_input"
                    android:hint="@string/auth_password"
                    android:inputType="textPassword"
                    android:paddingHorizontal="20dp"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#999999" />

                <TextView
                    android:id="@+id/loginError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:textColor="#FFFF7777"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/loginButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setting_option"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:text="@string/auth_login"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />

                    <Button
                        android:id="@+id/qrRetryButton"
                        android:layout_width="0dp"
                        android:layout_height="60dp"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_setting_option"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:text="@string/auth_qr_retry"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="340dp"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false">

                <ImageView
                    android:id="@+id/qrImage"
                    android:layout_width="240dp"
                    android:layout_height="240dp"
                    android:layout_gravity="center"
                    android:background="#FFFFFF"
                    android:padding="10dp"
                    android:contentDescription="@string/auth_scan_qr" />
            </FrameLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/qrInfoPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="8dp"
            android:paddingBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_scan_qr"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/qrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#BBBBBB"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/auth_qr_phone"
                android:textColor="#BBBBBB"
                android:textSize="14sp" />
        </LinearLayout>
    </FrameLayout>

</FrameLayout>

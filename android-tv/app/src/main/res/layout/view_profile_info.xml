<?xml version="1.0" encoding="utf-8"?>

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================================================= -->
    <!-- Logged User -->
    <!-- ================================================= -->

    <LinearLayout
        android:id="@+id/layoutLogged"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical"

        android:visibility="gone">

        <TextView
            android:id="@+id/accountName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:textColor="#FFFFFF"
            android:textSize="22sp"/>

        <include
            android:id="@+id/heroContainer"
            layout="@layout/layout_hero"
            android:layout_width="match_parent"
            android:layout_height="280dp"/>

        <Button
            android:id="@+id/logoutButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="@string/auth_logout"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_setting_option"
            android:focusable="true"
            android:focusableInTouchMode="true"/>

    </LinearLayout>

    <!-- ================================================= -->
    <!-- Login -->
    <!-- ================================================= -->

    <LinearLayout

        android:id="@+id/layoutLogin"

        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="horizontal"

        android:gravity="center"

        android:visibility="visible">

        <!-- LEFT -->

        <LinearLayout

            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingEnd="40dp"
            android:orientation="vertical">

            <EditText

                android:id="@+id/emailInput"

                android:layout_width="match_parent"
                android:layout_height="58dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/bg_search_input"

                android:textColor="#FFFFFF"
                android:textColorHint="#999999"

                android:hint="@string/auth_username_email"

                android:paddingHorizontal="20dp"

                android:singleLine="true"/>

            <EditText

                android:id="@+id/passwordInput"

                android:layout_width="match_parent"
                android:layout_height="58dp"

                android:layout_marginTop="8dp"

                android:background="@drawable/bg_search_input"

                android:textColor="#FFFFFF"

                android:textColorHint="#999999"

                android:hint="@string/auth_password"

                android:paddingHorizontal="20dp"

                android:singleLine="true"

                android:inputType="textPassword"/>

            <TextView
                android:id="@+id/loginError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:textColor="#FFFF7777"
                android:visibility="gone"/>

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="34dp"

                android:text="@string/auth_login"

                android:textAllCaps="false"
                android:textSize="18sp"
                android:textColor="#FFFFFF"

                android:background="@drawable/bg_setting_option"

                android:focusable="true"
                android:focusableInTouchMode="true"/>

        </LinearLayout>

        <!-- RIGHT -->

        <LinearLayout

            android:layout_width="340dp"
            android:layout_height="wrap_content"

            android:gravity="center"

            android:orientation="vertical">

            <ImageView

                android:id="@+id/qrImage"

                android:layout_width="240dp"
                android:layout_height="240dp"

                android:background="#FFFFFF"

                android:padding="10dp"/>

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="22dp"

                android:text="@string/auth_scan_qr"

                android:textColor="#FFFFFF"

                android:textStyle="bold"

                android:textSize="18sp"/>

            <TextView
                android:id="@+id/qrStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:textColor="#BBBBBB"
                android:textSize="14sp"/>

            <Button
                android:id="@+id/qrRetryButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/auth_qr_retry"
                android:textAllCaps="false"/>

            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:layout_marginTop="6dp"

                android:text="@string/auth_qr_phone"

                android:textColor="#BBBBBB"

                android:textSize="14sp"/>

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/syncPrompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_margin="48dp"
        android:background="#F0222222"
        android:elevation="16dp"
        android:orientation="vertical"
        android:padding="28dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/syncPromptText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/auth_sync_prompt"
            android:textColor="#FFFFFF"
            android:textSize="20sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <Button
                android:id="@+id/syncNoButton"
                android:layout_width="180dp"
                android:layout_height="56dp"
                android:layout_marginEnd="16dp"
                android:text="@string/auth_sync_no"
                android:textAllCaps="false"/>

            <Button
                android:id="@+id/syncYesButton"
                android:layout_width="180dp"
                android:layout_height="56dp"
                android:text="@string/auth_sync_yes"
                android:textAllCaps="false"/>
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
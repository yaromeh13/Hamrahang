<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/queueItemRoot"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp"
    android:layout_marginVertical="2dp"
    android:layout_marginHorizontal="4dp"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:clickable="true"
    android:nextFocusRight="@id/btnQueueRemove"
    android:descendantFocusability="beforeDescendants"
    android:background="@drawable/bg_playlist_item">

    <ImageView
        android:id="@+id/PlsCover"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:scaleType="centerCrop"
        android:src="@drawable/default_album"/>

    <ImageView
        android:id="@+id/imgQueueMediaType"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="10dp"
        android:scaleType="fitCenter"
        android:contentDescription="Media type"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/songTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:maxLines="1"
            android:ellipsize="end"/>

        <TextView
            android:id="@+id/songArtist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#B5FFFFFF"
            android:textSize="14sp"
            android:maxLines="1"
            android:ellipsize="end"/>

    </LinearLayout>

    <TextView
        android:id="@+id/btnQueueRemove"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:gravity="center"
        android:text="×"
        android:textColor="#FFFFFFFF"
        android:textSize="26sp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:nextFocusLeft="@id/queueItemRoot"
        android:nextFocusRight="@id/btnQueueMore"
        android:background="@drawable/bg_queue_action_focus"
        android:contentDescription="Remove from queue"/>

    <ImageButton
        android:id="@+id/btnQueueMore"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="0dp"
        android:src="@drawable/ic_more"
        android:scaleType="centerInside"
        android:padding="0dp"
        android:tint="#FFFFFFFF"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:nextFocusLeft="@id/btnQueueRemove"
        android:background="@drawable/bg_queue_action_focus"
        android:contentDescription="More options"/>

</LinearLayout>
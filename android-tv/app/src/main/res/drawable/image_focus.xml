            <solid android:color="#2A2A2A"/>
            <stroke
                android:width="2dp"
                android:color="#2A2A2A"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <item>
        <shape>
            <solid android:color="#444444"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

</selector>